NEXTRIP_BE_HOST=0.0.0.0
NEXTRIP_BE_PORT=8000
NEXTRIP_KB_BASE_URL=http://127.0.0.1:8010
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Answer Agent. Keep template mode for a dependency-free local demo.
ANSWER_GENERATION_MODE=template
GEMINI_MODEL=gemini-2.5-flash
ANSWER_TEMPERATURE=0.2

# Gemini Developer API authentication.
GOOGLE_API_KEY=

# Or use Gemini on Vertex AI with local ADC/service-account credentials.
# Use an absolute credentials path, or a path relative to the NexTripAI-BE directory.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
