NEXTRIP_BE_HOST=0.0.0.0
NEXTRIP_BE_PORT=8000
NEXTRIP_KB_BASE_URL=http://127.0.0.1:8010
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=false
AI_WORKER_COUNT=5
AI_QUEUE_CAPACITY=100
CHAT_REQUEST_TIMEOUT_SECONDS=75
KB_REQUEST_TIMEOUT_SECONDS=25

# Real Firebase accounts are the default in every runtime environment.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
# Grant privileged access only through signed Firebase custom claims such as
# `role=admin` or `role=support`.
KB_AUTH_MODE=none
KB_AUTH_AUDIENCE=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# KB readiness/version policy. Production should set ALLOW_CLIENT_KB_VERSION=false.
ACTIVE_KB_VERSION=v8
KB_FALLBACK_VERSIONS=
ALLOW_CLIENT_KB_VERSION=false
IDEMPOTENCY_TTL_SECONDS=900
RESILIENCE_RETRY_ATTEMPTS=1
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Answer Agent. Keep template mode for a dependency-free local demo.
ANSWER_GENERATION_MODE=template
# Also used as the low-cost AI judge for Excel evaluation jobs.
GEMINI_CONTEXT_MODEL=gemini-3.5-flash-lite
GEMINI_ANSWER_MODEL=gemini-3.5-flash-lite
# Planning uses structured output and more reasoning than intent routing.
GEMINI_PLANNING_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_PLANNING_THINKING_LEVEL=medium
GEMINI_TIMEOUT_SECONDS=35
ANSWER_TEMPERATURE=0.2
# Set these from the current model pricing; zero disables non-zero cost estimates.
GEMINI_INPUT_COST_PER_MILLION_USD=0
GEMINI_OUTPUT_COST_PER_MILLION_USD=0

# Gemini Developer API authentication.
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
ROUTES_TIMEOUT_SECONDS=10
ROUTES_CACHE_TTL_SECONDS=604800

# Open-Meteo public forecast API does not require an API key for non-commercial use.
WEATHER_TIMEOUT_SECONDS=8

# Conversation persistence. Firestore can use an attached service account/ADC or
# FIRESTORE_CREDENTIALS_PATH for local development.
CHAT_STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
FIRESTORE_CREDENTIALS_PATH=
FIRESTORE_DATABASE=(default)
FIRESTORE_SESSIONS_COLLECTION=chat_sessions
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_AUDIT_COLLECTION=admin_audit_logs

# Must match KB_ADMIN_API_KEY on the private KB service.
KB_ADMIN_API_KEY=

# Export traces and metrics through an OTLP collector when enabled.
TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=nextrip-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
