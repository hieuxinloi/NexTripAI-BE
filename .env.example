NEXTRIP_BE_HOST=0.0.0.0
NEXTRIP_BE_PORT=8000
NEXTRIP_KB_BASE_URL=http://127.0.0.1:8010
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=false
AI_WORKER_COUNT=5
AI_QUEUE_CAPACITY=100
CHAT_REQUEST_TIMEOUT_SECONDS=45
KB_REQUEST_TIMEOUT_SECONDS=25

# Product security. In production, use firebase and attach a Cloud Run service
# account to BE; do not set GOOGLE_APPLICATION_CREDENTIALS in Cloud Run.
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=
KB_AUTH_MODE=none
KB_AUTH_AUDIENCE=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# KB readiness/version policy. Production should set ALLOW_CLIENT_KB_VERSION=false.
ACTIVE_KB_VERSION=v3
KB_FALLBACK_VERSIONS=v1
ALLOW_CLIENT_KB_VERSION=true
IDEMPOTENCY_TTL_SECONDS=900
RESILIENCE_RETRY_ATTEMPTS=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Answer Agent. Keep template mode for a dependency-free local demo.
ANSWER_GENERATION_MODE=template
GEMINI_MODEL=gemini-2.5-flash
ANSWER_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=35
# Set these from the current model pricing; zero disables non-zero cost estimates.
GEMINI_INPUT_COST_PER_MILLION_USD=0
GEMINI_OUTPUT_COST_PER_MILLION_USD=0

# Gemini Developer API authentication.
GOOGLE_API_KEY=

# Or use Gemini on Vertex AI with local ADC/service-account credentials.
# Use an absolute credentials path, or a path relative to the NexTripAI-BE directory.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Open-Meteo public forecast API does not require an API key for non-commercial use.
WEATHER_TIMEOUT_SECONDS=8

# Conversation persistence. Use firestore in deployed environments.
CHAT_STORE_BACKEND=memory
FIRESTORE_DATABASE=(default)
FIRESTORE_SESSIONS_COLLECTION=chat_sessions
CHAT_HISTORY_LIMIT=8

# Export traces and metrics through an OTLP collector when enabled.
TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=nextrip-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
